{
  "name": "astral-loom-cli",
  "version": "1.0.0",
  "description": "Command-line developer tool for Stellar accounts, Soroban smart contracts, and transactions.",
  "main": "dist/index.js",
  "bin": {
    "loom": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astral-loom/astral-loom-cli.git"
  },
  "homepage": "https://github.com/astral-loom/astral-loom-cli#readme",
  "bugs": {
    "url": "https://github.com/astral-loom/astral-loom-cli/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "cli",
    "smart-contracts",
    "xdr",
    "blockchain",
    "developer-tools",
    "typescript"
  ],
  "author": "Temmy2026",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
